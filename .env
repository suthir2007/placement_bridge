FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=placement-pilot-super-secret-key-change-in-prod-2026
JWT_SECRET_KEY=jwt-secret-placement-pilot-key-change-in-prod

# Database URL (SQLite default for zero-setup, MySQL 8 supported)
# MySQL format: mysql+pymysql://root:password@localhost:3306/placement_pilot
DATABASE_URL=sqlite:///placement_pilot.db

# CORS Origin
FRONTEND_ORIGIN=http://localhost:5000

# AI Config (Optional: mock fallback used if blank)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (Optional)
APPLE_CLIENT_ID=
